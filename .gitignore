# Local build artefacts
/bin/
/dist/
/.tools/

# Editor scratch
/.idea/
/.vscode/
*.swp

# Local kanban data (developer running `kanban serve` locally)
/data/

# Test coverage
/coverage.out
*.cover

# OS junk
.DS_Store
Thumbs.db

# Go vendor caches (we use go.mod, not vendor)
/vendor/

# Agent scratch
/.agentlogs/
.agentlogs/

# Internal working material — reviews, critiques, agent briefs and handovers
# stay local and are never published.
docs/reviews/
docs/tasks/
*-review-*.md
*REVIEW*.md
*-handover.md
# Compiled binaries (never commit — a 23MB exe was tracked once already)
/kanban
/kanban.exe
*.exe
