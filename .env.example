# basic-kanban-board-mcp — example configuration.
# Every KANBAN_* variable mirrors a `kanban serve` flag. Copy to .env (which is
# gitignored) and edit. Do NOT commit real tokens.

# Listen address. Loopback by default. A remote bind (e.g. 0.0.0.0:8080) also
# requires TLS via a proxy + KANBAN_BASE_URL=https://…, or KANBAN_INSECURE_HTTP=true.
KANBAN_ADDR=127.0.0.1:8080

# Directory holding the SQLite database.
KANBAN_DATA=./data

# Public origin used for redirects and cookie Secure.
# KANBAN_BASE_URL=https://kanban.example.com

# Bootstrap admin token. If unset, one is generated and printed once at startup.
# Prefer a file mount over an inline value:
# KANBAN_ADMIN_TOKEN_FILE=/run/secrets/kanban_admin_token
# KANBAN_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Allow a plain-HTTP remote listener (only behind a TLS-terminating proxy, or for
# local evaluation). The Docker image sets this to true for that reason.
# KANBAN_INSECURE_HTTP=false

# Comma-separated CIDRs trusted to set X-Forwarded-* (e.g. 10.0.0.0/8,127.0.0.1/32).
# KANBAN_TRUSTED_PROXIES=

# Seed a labeled sample project on a brand-new database (default true).
# KANBAN_DEMO=true

KANBAN_LOG_LEVEL=info
KANBAN_LOG_FORMAT=text
